<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Define o parent do Spring Boot que gerencia versões compatíveis automaticamente -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.7.2</version>
		<relativePath/>
	</parent>

	<!-- Identificação do projeto -->
	<groupId>com.project</groupId>
	<artifactId>learning</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<name>learning</name>
	<description>Learning Spring Boot</description>

	<!-- Versão do Java usada pelo projeto -->
	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
	
		<!-- Starter Web: fornece suporte a REST APIs (Spring MVC + Tomcat embutido) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
    		<version>2.7.3</version>
		</dependency>

		<!-- DevTools: reload automático para acelerar desenvolvimento -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
    		<version>2.7.3</version>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		
		<!-- Dependências para testes (JUnit, Mockito, etc.) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
    		<version>2.7.3</version>
			<scope>test</scope>
		</dependency>

		<!-- JPA: abstração para persistência + Hibernate como implementação -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
    		<version>2.7.3</version>
		</dependency>

		<!-- Validação de dados (@Valid, @NotNull, etc.) -->
		<dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
    		<version>2.7.3</version>
        </dependency>
		
		<!-- Banco em memória (usado geralmente em dev/testes) -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
    		<version>2.1.214</version>
			<scope>runtime</scope>
		</dependency>
		
		<!-- Driver MySQL para ambiente real -->
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
    		<version>8.0.30</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Lombok: reduz boilerplate (getters, setters, constructors, etc.) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
    		<version>1.18.24</version>
			<scope>provided</scope>
		</dependency>

		<!-- Biblioteca utilitária (usada no projeto para stacktrace) -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>3.12.0</version>	
		</dependency>

		<!-- Spring Security: autenticação e autorização -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
			<version>2.7.3</version>
		</dependency>

		<!-- JWT: autenticação baseada em token -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.11.5</version>
		</dependency>

		<!-- Implementação JWT -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>
		
		<!-- Integração JWT com Jackson (serialização JSON) -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.11.5</version>
			<scope>runtime</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>

			<!-- Plugin responsável por empacotar e rodar aplicação Spring Boot -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

		</plugins>
	</build>

</project>